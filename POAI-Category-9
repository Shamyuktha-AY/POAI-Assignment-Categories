        "#2. Fuzzy Inferencing System\n",
        "\n",
        "\n",
        "\n",
        "#Definition: A Fuzzy Inferencing System is a reasoning technique that handles uncertainty using degrees of truth between 0 and 1 instead of only true or false values.\n",
        "\n",
        "#It consists of three main stages:\n",
        "#1. Fuzzification: Converts crisp input values into fuzzy values.\n",
        "#2. Rule Evaluation: Applies IF-THEN rules.\n",
        "#3. Defuzzification: Converts fuzzy results into a final numerical output.\n",
        "\n",
        "\n",
        "\n",
        "# FUZZY INFERENCING SYSTEM\n",
        "\n",
        "def membership(value, low, medium, high):\n",
        "    # Low membership\n",
        "    l = max(0, min(1, (medium - value) / (medium - low)))\n",
        "\n",
        "    # Medium membership\n",
        "    m = max(0, 1 - abs(value - medium) / (medium - low))\n",
        "\n",
        "    # High membership\n",
        "    h = max(0, min(1, (value - medium) / (high - medium)))\n",
        "\n",
        "    return l, m, h\n",
        "\n",
        "\n",
        "def fuzzy_system(value):\n",
        "    low, medium, high = membership(value, 0, 50, 100)\n",
        "\n",
        "    # IF-THEN rules\n",
        "    rules = [\n",
        "        (low, 20),\n",
        "        (medium, 50),\n",
        "        (high, 90)\n",
        "    ]\n",
        "\n",
        "    numerator = sum(strength * output for strength, output in rules)\n",
        "    denominator = sum(strength for strength, output in rules)\n",
        "\n",
        "    if denominator == 0:\n",
        "        return 0\n",
        "\n",
        "    return numerator / denominator\n",
        "\n",
        "\n",
        "# 1. Medical Diagnosis\n",
        "# Input: Symptom severity (0-100)\n",
        "\n",
        "print(\"MEDICAL DIAGNOSIS\")\n",
        "severity = 80\n",
        "risk = fuzzy_system(severity)\n",
        "\n",
        "print(\"Symptom Severity:\", severity)\n",
        "print(\"Health Risk:\", round(risk, 2))\n",
        "\n",
        "if risk >= 70:\n",
