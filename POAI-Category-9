        "                                                           #CATEGORY-9\n",
        "\n",
        "\n",
        "#1. Bayesian Reasoning\n",
        "#Definition: Bayesian Reasoning is a probability-based technique used to make decisions under uncertainty. It updates the probability of an event based on newly available evidence.\n",
        "\n",
        "#(Bayes' Theorem:\n",
        "#\\[\n",
        "#P(H|E)=\\frac{P(E|H)\\times P(H)}{P(E)}\n",
        "#\\]\n",
        "\n",
        "#Where:\n",
        "#- \\(P(H)\\) = Prior probability of a hypothesis.\n",
        "##- \\(P(E|H)\\) = Probability of evidence given the hypothesis.\n",
        "#- \\(P(H|E)\\) = Posterior probability.\n",
        "#Python Program\n",
        "#The following program demonstrates Bayesian reasoning in three applications:\n",
        "#- Medical Diagnosis – Predicting the possibility of a disease.\n",
        "#- Autonomous Vehicle – Detecting the possibility of an obstacle.\n",
        "#- Smart Manufacturing – Detecting machine failure.\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "# BAYESIAN REASONING\n",
        "\n",
        "def bayes(prior, likelihood, false_likelihood):\n",
        "    numerator = prior * likelihood\n",
        "    denominator = numerator + (1 - prior) * false_likelihood\n",
        "    return numerator / denominator\n",
        "\n",
        "\n",
        "# 1. Medical Diagnosis\n",
        "# Probability of disease based on a positive test\n",
        "\n",
        "disease = bayes(0.10, 0.90, 0.05)\n",
        "print(\"MEDICAL DIAGNOSIS\")\n",
        "print(\"Probability of disease:\", round(disease * 100, 2), \"%\")\n",
        "\n",
        "\n",
        "# 2. Autonomous Vehicle\n",
        "# Probability of obstacle based on sensor detection\n",
        "\n",
        "obstacle = bayes(0.20, 0.95, 0.10)\n",
        "print(\"\\nAUTONOMOUS VEHICLE\")\n",
        "print(\"Probability of obstacle:\", round(obstacle * 100, 2), \"%\")\n",
        "\n",
        "if obstacle > 0.70:\n",
        "    print(\"Action: Apply Emergency Brake\")\n",
        "else:\n",
        "    print(\"Action: Continue Driving\")\n",
        "\n",
        "\n",
        "# 3. Smart Manufacturing\n",
        "# Probability of machine failure based on abnormal vibration\n",
        "\n",
        "failure = bayes(0.10, 0.85, 0.15)\n",
